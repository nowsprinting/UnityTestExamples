is_global = true

# CS0618: Type or member is obsolete
dotnet_diagnostic.CS0618.severity = error

# UTF2006: Property constraints, Ordered.By, and List.Map(...).Property lookup properties that managed code stripping can remove
dotnet_diagnostic.UTF2006.severity = warning

# UTF4004-UTF4007: Recommendations against fixed-time waits and coroutine-style tests; this project demonstrates those APIs
dotnet_diagnostic.UTF4004.severity = suggestion
dotnet_diagnostic.UTF4005.severity = suggestion
dotnet_diagnostic.UTF4006.severity = suggestion
dotnet_diagnostic.UTF4007.severity = suggestion